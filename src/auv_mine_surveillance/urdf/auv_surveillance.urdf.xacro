<?xml version="1.0"?>
<robot name="auv_surveillance" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="hull_length" value="1.80"/>
  <xacro:property name="hull_radius" value="0.13"/>
  <xacro:property name="mass_rigid"  value="35.0"/>

  <!-- BASE LINK — torpedo hull -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="35.0"/>
      <inertia ixx="2.52" ixy="0.0" ixz="0.0"
                           iyy="9.75" iyz="0.0"
                                      izz="9.75"/>
    </inertial>
    <visual name="hull">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.13" length="1.80"/></geometry>
      <material name="auv_grey"><color rgba="0.22 0.25 0.28 1.0"/></material>
    </visual>
    <visual name="nose">
      <origin xyz="0.90 0 0" rpy="0 1.5708 0"/>
      <geometry><sphere radius="0.13"/></geometry>
      <material name="nose_mat"><color rgba="0.18 0.22 0.26 1.0"/></material>
    </visual>
    <collision name="hull_col">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.13" length="1.80"/></geometry>
    </collision>
  </link>

  <!-- THRUSTER PORT SURGE -->
  <joint name="thruster_port_surge_joint" type="continuous">
    <parent link="base_link"/>
    <child link="thruster_port_surge"/>
    <origin xyz="-0.90 0.09 0" rpy="0 1.5708 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="thruster_port_surge">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0008" ixy="0.0" ixz="0.0"
                             iyy="0.0008" iyz="0.0"
                                          izz="0.0008"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.04" length="0.10"/></geometry>
      <material name="thr_mat"><color rgba="0.35 0.38 0.42 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.10"/></geometry>
    </collision>
  </link>

  <!-- THRUSTER STARBOARD SURGE -->
  <joint name="thruster_stbd_surge_joint" type="continuous">
    <parent link="base_link"/>
    <child link="thruster_stbd_surge"/>
    <origin xyz="-0.90 -0.09 0" rpy="0 1.5708 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="thruster_stbd_surge">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0008" ixy="0.0" ixz="0.0"
                             iyy="0.0008" iyz="0.0"
                                          izz="0.0008"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.04" length="0.10"/></geometry>
      <material name="thr_mat2"><color rgba="0.35 0.38 0.42 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.10"/></geometry>
    </collision>
  </link>

  <!-- THRUSTER HEAVE -->
  <joint name="thruster_heave_joint" type="continuous">
    <parent link="base_link"/>
    <child link="thruster_heave"/>
    <origin xyz="0.0 0 -0.18" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="thruster_heave">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0008" ixy="0.0" ixz="0.0"
                             iyy="0.0008" iyz="0.0"
                                          izz="0.0008"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.04" length="0.10"/></geometry>
      <material name="heave_mat"><color rgba="0.45 0.35 0.25 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.10"/></geometry>
    </collision>
  </link>

  <!-- THRUSTER YAW -->
  <joint name="thruster_yaw_joint" type="continuous">
    <parent link="base_link"/>
    <child link="thruster_yaw"/>
    <origin xyz="-0.54 0 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="thruster_yaw">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0008" ixy="0.0" ixz="0.0"
                             iyy="0.0008" iyz="0.0"
                                          izz="0.0008"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.04" length="0.10"/></geometry>
      <material name="yaw_mat"><color rgba="0.25 0.35 0.45 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.10"/></geometry>
    </collision>
  </link>

  <!-- IMU LINK -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0"
                           iyy="1e-6" iyz="0.0"
                                      izz="1e-6"/>
    </inertial>
    <visual>
      <geometry><box size="0.02 0.02 0.01"/></geometry>
      <material name="imu_col"><color rgba="0.8 0.2 0.2 1.0"/></material>
    </visual>
  </link>

  <!-- DVL LINK -->
  <joint name="dvl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="dvl_link"/>
    <origin xyz="-0.2 0 -0.13" rpy="0 3.14159 0"/>
  </joint>
  <link name="dvl_link">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                             iyy="0.0001" iyz="0.0"
                                          izz="0.0001"/>
    </inertial>
    <visual>
      <geometry><box size="0.08 0.08 0.04"/></geometry>
      <material name="dvl_col"><color rgba="0.2 0.6 0.2 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.08 0.08 0.04"/></geometry>
    </collision>
  </link>

  <!-- DEPTH SENSOR LINK -->
  <joint name="depth_joint" type="fixed">
    <parent link="base_link"/>
    <child link="depth_sensor_link"/>
    <origin xyz="0.3 0 -0.13" rpy="0 0 0"/>
  </joint>
  <link name="depth_sensor_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
                              iyy="0.00001" iyz="0.0"
                                            izz="0.00001"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.015" length="0.04"/></geometry>
      <material name="dep_col"><color rgba="0.2 0.2 0.8 1.0"/></material>
    </visual>
  </link>

  <!-- SONAR LINK -->
  <joint name="sonar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sonar_link"/>
    <origin xyz="0.495 0 0.104" rpy="0 -0.2 0"/>
  </joint>
  <link name="sonar_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                             iyy="0.0001" iyz="0.0"
                                          izz="0.0001"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.04"/></geometry>
      <material name="sonar_col"><color rgba="0.6 0.6 0.2 1.0"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="0.04"/></geometry>
    </collision>
  </link>

  <!-- ══════════════════════════════════════════════════════════════ -->
  <!--                     GAZEBO PLUGINS                            -->
  <!-- ══════════════════════════════════════════════════════════════ -->

  <!-- IMU Plugin -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>50.0</update_rate>
      <visualize>false</visualize>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/auv</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>imu_link</frame_name>
        <update_rate>50.0</update_rate>
        <gaussian_noise>0.001</gaussian_noise>
      </plugin>
    </sensor>
  </gazebo>

  <!-- DVL Plugin — 4-beam ray sensor pointing down -->
  <gazebo reference="dvl_link">
    <sensor name="dvl_sensor" type="ray">
      <always_on>true</always_on>
      <update_rate>8.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>4</samples>
            <resolution>1</resolution>
            <min_angle>-0.52</min_angle>
            <max_angle>0.52</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.5</min>
          <max>200.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.02</stddev>
        </noise>
      </ray>
      <plugin name="dvl_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/auv</namespace>
          <remapping>~/out:=dvl/ranges</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>dvl_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Depth Sensor Plugin -->
  <gazebo reference="depth_sensor_link">
    <sensor name="depth_sensor" type="ray">
      <always_on>true</always_on>
      <update_rate>20.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>500.0</max>
          <resolution>0.001</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </ray>
      <plugin name="depth_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/auv</namespace>
          <remapping>~/out:=depth/range</remapping>
        </ros>
        <output_type>sensor_msgs/Range</output_type>
        <frame_name>depth_sensor_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Forward-Looking Sonar — 120 degree azimuth, 30m max range -->
  <gazebo reference="sonar_link">
    <sensor name="sonar_fls" type="ray">
      <always_on>true</always_on>
      <update_rate>5.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>120</samples>
            <resolution>1</resolution>
            <min_angle>-1.047</min_angle>
            <max_angle>1.047</max_angle>
          </horizontal>
          <vertical>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.087</min_angle>
            <max_angle>0.087</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.5</min>
          <max>30.0</max>
          <resolution>0.05</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.05</stddev>
        </noise>
      </ray>
      <plugin name="sonar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/auv</namespace>
          <remapping>~/out:=sonar/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>sonar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Buoyancy: +4.9N net upthrust (surfaces on power loss) -->
  <gazebo reference="base_link">
    <buoyancy>
      <link_name>base_link</link_name>
      <volume>0.03463</volume>
      <center_of_volume>0 0 0.02</center_of_volume>
    </buoyancy>
  </gazebo>

  <!-- THRUSTER FORCE PLUGINS - correct ROS2 Humble syntax -->
  <gazebo>
    <plugin name="thruster_port_surge_plugin" filename="libgazebo_ros_force.so">
      <ros><remapping>~/cmd_force:=/auv/thruster/port_surge/cmd_force</remapping></ros>
      <link_name>thruster_port_surge</link_name>
      <force_frame>link</force_frame>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin name="thruster_stbd_surge_plugin" filename="libgazebo_ros_force.so">
      <ros><remapping>~/cmd_force:=/auv/thruster/stbd_surge/cmd_force</remapping></ros>
      <link_name>thruster_stbd_surge</link_name>
      <force_frame>link</force_frame>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin name="thruster_heave_plugin" filename="libgazebo_ros_force.so">
      <ros><remapping>~/cmd_force:=/auv/thruster/heave/cmd_force</remapping></ros>
      <link_name>thruster_heave</link_name>
      <force_frame>link</force_frame>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin name="thruster_yaw_plugin" filename="libgazebo_ros_force.so">
      <ros><remapping>~/cmd_force:=/auv/thruster/yaw/cmd_force</remapping></ros>
      <link_name>thruster_yaw</link_name>
      <force_frame>link</force_frame>
    </plugin>
  </gazebo>
</robot>